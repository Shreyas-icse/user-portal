<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>Premium Plan Payment</title>
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
  <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    body {
      background-color: #121212;
      color: #ffffff;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    .payment-container {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .payment-box {
      background-color: #1f1f1f;
      padding: 40px;
      border-radius: 16px;
      box-shadow: 0 0 25px rgba(0, 0, 0, 0.5);
      width: 100%;
      max-width: 600px;
    }
    .plan-card {
      background-color: #2c2c2c;
      border: 2px solid transparent;
      padding: 20px;
      border-radius: 12px;
      cursor: pointer;
      transition: 0.3s ease;
      margin-bottom: 16px;
    }
    .plan-card:hover {
      background-color: #333;
      border-color: #007bff;
    }
    .plan-card.selected {
      border-color: #0d6efd;
      background-color: #343a40;
    }
    .btn-primary {
      background-color: #0d6efd;
      border: none;
    }
    .btn-primary:hover {
      background-color: #0b5ed7;
    }
    small {
      display: block;
      margin-top: 8px;
      color: #bbb;
      font-size: 0.85rem;
    }
  </style>
</head>

<body>
  <div class="container payment-container">
    <div class="payment-box text-white">
      <h3 class="text-center mb-4">Choose a Premium Plan</h3>
      <form class="pay-form" method="POST">
        <div class="plan-card" data-amount="49" data-description="1 Month Premium">
          <h5>1 Month – ₹49</h5>
          <p><small>30 days of boosted visibility. Appear higher in user search and get more bookings.</small></p>
        </div>
        <div class="plan-card" data-amount="130" data-description="3 Months Premium">
          <h5>3 Months – ₹130</h5>
          <p><small>90 days of top visibility. Build trust and get steady job bookings.</small></p>
        </div>
        <div class="plan-card" data-amount="240" data-description="6 Months Premium">
          <h5>6 Months – ₹240</h5>
          <p><small>Half-year premium listing. Seen by more users, better chances for long-term jobs.</small></p>
        </div>
        <div class="plan-card" data-amount="450" data-description="1 Year Premium">
          <h5>1 Year – ₹450</h5>
          <p><small>Full year visibility. Best value for full-time workers to get more and better jobs.</small></p>
        </div>

        <input type="hidden" id="selectedAmount" />
        <input type="hidden" id="selectedDescription" />

        <div class="d-grid mt-4">
          <button type="submit" class="btn btn-primary btn-lg">Pay Now</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    $(document).ready(function () {
      let selectedCard = null;

      $('.plan-card').click(function () {
        $('.plan-card').removeClass('selected');
        $(this).addClass('selected');
        $('#selectedAmount').val($(this).data('amount'));
        $('#selectedDescription').val($(this).data('description'));
        selectedCard = $(this);
      });

      $('.pay-form').submit(function (e) {
        e.preventDefault();

        const amount = $('#selectedAmount').val();
        const description = $('#selectedDescription').val();

        if (!amount || !description) {
          alert("Please select a plan.");
          return;
        }

        $.ajax({
          url: "/createOrder",
          type: "POST",
          data: {
            amount: amount,
            description: description
          },
          success: function (res) {
            if (res.success) {
              const options = {
                "key": res.key_id,
                "amount": res.amount,
                "currency": "INR",
                "name": res.product_name,
                "description": res.description,
                "image": "https://dummyimage.com/600x400/000/fff",
                "order_id": res.order_id,
                "handler": function (response) {
                  alert("Payment Succeeded");
                },
                "prefill": {
                  "contact": res.contact,
                  "name": res.name,
                  "email": res.email
                },
                "notes": {
                  "description": res.description
                },
                "theme": {
                  "color": "#0d6efd"
                }
              };
              const rzp = new Razorpay(options);
              rzp.on('payment.failed', function () {
                alert("Payment Failed");
              });
              rzp.open();
            } else {
              alert(res.msg);
            }
          }
        });
      });
    });
  </script>
</body>
</html>
